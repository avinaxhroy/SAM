# Build output — never in the repo. `node`/`pnpm` are build-time only and
# pinned by `ui/pnpm-lock.yaml` (§7: the shipped app and CLI contain no
# interpreter), so the frontend's install and bundle are ignored, not carried.

/target
/ui/node_modules
/ui/dist

# Swift toolchain output from the pre-port reference tree. The tree itself is
# gone (§6.1); this stays so a stray build never enters the repo.
/.build

# macOS / OS metadata
.DS_Store
**/.DS_Store
Thumbs.db
Desktop.ini

# Generated by `cargo tauri` — the capability schemas, and the CLI sidecar that
# tools/sidecar.mjs names per target triple (the real binary lives in target/).
/src-tauri/gen
/src-tauri/binaries

# Test captures and visual diff outputs
/.captures

# Temporary scratch and local audit workspace
/tmp


# Environment and secrets
.env
.env.*
*.env
!.env.example

# IDE & Editor files
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.svelte text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Test fixtures explicitly testing CRLF tolerance
**/fixtures/crlf-ok/** text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.icns binary
*.sqlite binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
*.dylib binary
*.so binary
*.dll binary

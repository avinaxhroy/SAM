{
  "schemaVersion": 1,
  "pipelines": {
    "flip": {
      "stages": [
        "learned",
        "proved",
        "anchored"
      ],
      "gates": {
        "proved": {
          "require": "learned"
        },
        "anchored": {
          "require": "proved"
        }
      },
      "completeWhen": "anchored",
      "proof": {
        "appliesToKinds": [
          "watch"
        ],
        "minProblems": 2
      },
      "anchorSkip": {
        "allowed": true,
        "requireReason": true
      }
    },
    "progress": {
      "stages": [
        "started",
        "midway",
        "done"
      ],
      "progress": "pct"
    }
  },
  "scheduler": {
    "name": "sm2",
    "fixed": {
      "intervals": [
        1,
        7,
        30
      ]
    },
    "sm2": {
      "minEase": 1.3,
      "firstInterval": 1
    }
  },
  "metrics": {
    "minutes.studied": {
      "label": "Minutes studied",
      "view": "progress.sessions",
      "expr": "min",
      "reduce": "sum",
      "unit": "min"
    },
    "sessions.logged": {
      "label": "Sessions",
      "view": "progress.sessions",
      "reduce": "count"
    },
    "problems.solved": {
      "label": "Problems solved",
      "view": "practice.table",
      "expr": "solved",
      "reduce": "sum",
      "unit": "problems"
    },
    "topics.open": {
      "label": "Topics open",
      "view": "today.topics",
      "expr": "!complete()",
      "reduce": "count",
      "unit": "topics"
    },
    "tracks.active": {
      "label": "Tracks",
      "view": "tracks.board",
      "reduce": "count",
      "unit": "tracks"
    }
  },
  "study": {
    "dailyTargetMin": 120
  }
}

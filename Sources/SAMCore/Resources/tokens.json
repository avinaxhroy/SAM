    "material": {
      "$description": "Glass and light. Glass is for the chrome only — the rail and the floating layer. Nothing a student reads is translucent, and no card ever is. The material is carried by five edge rungs, because on a near-white sheet the edge *is* the material.",
      "glass": {
        "$type": "color",
        "$value": "color-mix(in oklab, {color.ink-level.ink} 5%, transparent)",
        "$description": "The rail pill's fill — and the only fill in the system this transparent. Liquid glass is mostly nothing: at 62% card the surface was painted on and no rim could make a painted plane into a lens, so the fill is a 5% veil of ink and the material lives on the edge (`glass-rim`, `glass-bounce`, `glass-glow`, `glass-veil`). Mixed from ink, not card, which makes it theme-automatic — ink is the dark of a light room and the light of a dark one, so one recipe darkens the sheet in light and lifts it in dark. In dark: 7% ink, because a dark surface has less room above it before the pane reads as a panel."
      },
      "glass-line": {
        "$type": "color",
        "$value": "oklch(100% 0 0 / 0.55)",
        "$description": "The 1px light-catch on the top edge of glass, and on the window's top edge. Lighting, not an emboss: it is on nothing you press. Thin and low-alpha by design — five whites at full strength is an opaque chip, not a lens. In dark: 14% white."
      },
      "glass-blur": {
        "$type": "dimension",
        "$value": "26px",
        "$description": "backdrop-filter blur for glass, with saturate(1.6)"
      },
      "room-lit": {
        "$type": "color",
        "$value": "color-mix(in oklab, {color.surface.backdrop} 88%, {color.surface.card})",
        "$description": "The room's light from above. The one gradient in the system: lightness only, no hue, no content. In dark: 86%."
      },
      "glass-rim": {
        "$type": "color",
        "$value": "oklch(100% 0 0 / 0.26)",
        "$description": "The boundary of the glass, lit all the way round. In dark: 10% white."
      },
      "glass-bounce": {
        "$type": "color",
        "$value": "oklch(100% 0 0 / 0.18)",
        "$description": "The same light leaving the far curve, dimmer than the top catch. In dark: 6% white."
      },
      "glass-glow": {
        "$type": "color",
        "$value": "oklch(100% 0 0 / 0.07)",
        "$description": "Light bending at the rim, as a soft inner glow — the lens, not a coat of paint. In dark: 4% white."
      },
      "glass-veil": {
        "$type": "color",
        "$value": "oklch(72% 0.014 260 / 0.26)",
        "$description": "A dark hairline outside the lit rim, so the lit edge has a dark side. In dark: 40% black."
      },
      "glass-sheen": {
        "$type": "gradient",
        "$value": "linear-gradient(180deg, oklch(100% 0 0 / 0.16), oklch(100% 0 0 / 0) 52%)",
        "$description": "Light from above, on the item the pointer has opened — a 44px-tall capsule gets a top-lit gloss. The rail's tube does not: the same gradient along 776px is a panel that fades, not a highlight. In dark: 6% white."
      },
      "pane": {
        "$type": "color",
        "$value": "color-mix(in oklab, {color.ink-level.ink-inv} 68%, transparent)",
        "$description": "A surface laid over a wash so words on the wash stay legible. Defined against ink-inv, so it inverts with the theme rather than being restated inside it."
      },
      "fill-on-ink": {
        "$type": "color",
        "$value": "color-mix(in oklab, {color.ink-level.ink-inv} 16%, transparent)",
        "$description": "The quieter half of a control that lives on the ink — the resting fill of a segment beside the active one."
      },
      "fill-on-ink-hi": {
        "$type": "color",
        "$value": "color-mix(in oklab, {color.ink-level.ink-inv} 26%, transparent)",
        "$description": "The same fill, one rung brighter: the hovered state of that control."
      },
      "scrim": {
        "$type": "color",
        "$value": "oklch(22% 0.01 260 / 0.28)",
        "$description": "The room, gone dark, behind the one floating layer. The only value in this group not mixed from a neighbour, because there is nothing behind the scrim to mix with.",
        "$extensions": { "hex": "#181b1f47" }
      }
    },
